---
/**
 * Gallery.astro - A lightweight, zero-dependency slide gallery component for Astro & MDX.
 * Supports image switching via click, navigation buttons, pagination dots, and arrow keys.
 */

interface Props {
  images: Array<string | { src: string }>;
}

const { images = [] } = Astro.props;
const imageUrls = images.map(img => typeof img === 'string' ? img : img.src);
---

{imageUrls.length > 0 && (
  <div class="mdx-slide-gallery">
    <div class="slide-viewport">
      <img class="active-image" src={imageUrls[0]} alt="Gallery Slide" />
      
      <button type="button" class="nav-btn prev-btn" aria-label="Previous slide">&#10094;</button>
      <button type="button" class="nav-btn next-btn" aria-label="Next slide">&#10095;</button>
      
      <div class="slide-counter">
        <span class="current-idx">1</span> / {imageUrls.length}
      </div>
    </div>

    <div class="dots-indicator">
      {imageUrls.map((_, idx) => (
        <button 
          type="button" 
          class={`dot ${idx === 0 ? 'active' : ''}`} 
          data-index={idx}
          aria-label={`Slide ${idx + 1}`}
        ></button>
      ))}
    </div>
  </div>
)}

<script>
  document.querySelectorAll('.mdx-slide-gallery').forEach((gallery) => {
    const imgElement = gallery.querySelector('.active-image') as HTMLImageElement;
    const prevBtn = gallery.querySelector('.prev-btn');
    const nextBtn = gallery.querySelector('.next-btn');
    const counter = gallery.querySelector('.current-idx');
    const dots = gallery.querySelectorAll('.dot');
    
    // Collect image paths from DOM/attributes
    const images: string[] = Array.from(dots).map((dot) => {
      const idx = Number(dot.getAttribute('data-index'));
      return idx === 0 ? imgElement.src : '';
    });

    let currentIndex = 0;

    function updateGallery(index: number) {
      if (index < 0) index = dots.length - 1;
      if (index >= dots.length) index = 0;
      currentIndex = index;

      const targetDot = dots[currentIndex] as HTMLElement;
      if (targetDot && targetDot.dataset.src) {
        imgElement.src = targetDot.dataset.src;
      }
      
      if (counter) counter.textContent = String(currentIndex + 1);

      dots.forEach((dot, i) => {
        dot.classList.toggle('active', i === currentIndex);
      });
    }

    // Read datasets from dots for image paths
    dots.forEach((dot, i) => {
      const dotEl = dot as HTMLElement;
      if (i === 0) dotEl.dataset.src = imgElement.src;
    });

    // Click on the main image -> Next slide
    imgElement?.addEventListener('click', () => updateGallery(currentIndex + 1));

    // Navigation buttons
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateGallery(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updateGallery(currentIndex + 1);
    });

    // Click on dot indicators
    dots.forEach((dot, i) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        updateGallery(i);
      });
    });

    // Arrow key navigation when gallery is visible
    window.addEventListener('keydown', (e) => {
      const rect = gallery.getBoundingClientRect();
      const isVisible = rect.top >= 0 && rect.bottom <= window.innerHeight;
      
      if (isVisible) {
        if (e.key === 'ArrowRight') updateGallery(currentIndex + 1);
        if (e.key === 'ArrowLeft') updateGallery(currentIndex - 1);
      }
    });
  });
</script>

<style>
  .mdx-slide-gallery {
    max-width: 720px;
    margin: 1.5rem auto;
    user-select: none;
  }

  .slide-viewport {
    position: relative;
    background-color: var(--sl-color-gray-6, #111);
    border: 1px solid var(--sl-color-gray-5, #333);
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .active-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: none;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s ease;
  }

  .nav-btn:hover {
    background: rgba(0, 0, 0, 0.85);
  }

  .prev-btn { left: 12px; }
  .next-btn { right: 12px; }

  .slide-counter {
    position: absolute;
    bottom: 10px;
    right: 12px;
    background: rgba(0, 0, 0, 0.7);
    color: #fff;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 0.8rem;
    font-family: monospace;
  }

  .dots-indicator {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: none;
    background-color: var(--sl-color-gray-4, #666);
    cursor: pointer;
    padding: 0;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .dot.active {
    background-color: var(--sl-color-accent, #7f52ff);
    transform: scale(1.25);
  }
</style>
